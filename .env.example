# PostgreSQL credentials used by the MLflow backend store.
POSTGRES_DB=replace-with-mlflow-database
POSTGRES_USER=replace-with-mlflow-user
POSTGRES_PASSWORD=replace-with-a-long-random-password

# MLflow is the only service published to the host. Defaults to 5000.
MLFLOW_PORT=5000

# Cloudflare R2 connection details used only by the MLflow service.
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_BUCKET=replace-with-r2-bucket
R2_PUBLIC_URL=replace-with-r2-prefix
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
