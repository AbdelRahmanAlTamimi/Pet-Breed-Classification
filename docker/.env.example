# Local development only. These credentials protect a stack that publishes ports
# on 127.0.0.1 only. Change every password below before exposing any port beyond
# localhost. Use letters, digits, '-', '_', '.' or '~' in passwords: the PostgreSQL
# password is embedded in a connection URI.
#
# Copy this file to docker/.env (git-ignored) and start the stack from the repo root:
#   docker compose -f docker/docker-compose.mlflow.yml up -d

POSTGRES_DB=mlflow
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=local-dev-only-change-me-postgres

# MinIO root user and password. The same pair is the S3 access key and secret that
# the MLflow server uses. MinIO requires a password of at least 8 characters.
MINIO_ROOT_USER=local-dev-only-minio-user
MINIO_ROOT_PASSWORD=local-dev-only-change-me-minio

# Host ports, both bound to 127.0.0.1. Only the MLflow API and the MinIO console
# are published; PostgreSQL and the MinIO S3 API stay inside the Docker network.
MLFLOW_PORT=5000
MINIO_CONSOLE_PORT=9001
